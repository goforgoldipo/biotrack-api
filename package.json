{
  "name": "biotrack-api",
  "version": "1.0.0",
  "description": "BioTrack Health Data API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit --verbose",
    "test:ci": "jest --runInBand --forceExit --ci --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testTimeout": 20000,
    "forceExit": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
